From 8616835611399a498e03e40311e1d8f014472d69 Mon Sep 17 00:00:00 2001
From: Yuanjie Yang <quic_yuanjiey@quicinc.com>
Date: Wed, 9 Oct 2024 18:45:44 +0800
Subject: [PATCH 64/71] ARM: dts: msm: Add sd card node for qcs615

The change add sd card node for qcs615 SoC.

Signed-off-by: Yuanjie Yang <quic_yuanjiey@quicinc.com>
---
 arch/arm64/boot/dts/qcom/qcs615-ride.dts |  11 +++
 arch/arm64/boot/dts/qcom/qcs615.dtsi     | 106 +++++++++++++++++++++++
 2 files changed, 117 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/qcs615-ride.dts b/arch/arm64/boot/dts/qcom/qcs615-ride.dts
index bf17a2fc715b..e904ae8fde96 100644
--- a/arch/arm64/boot/dts/qcom/qcs615-ride.dts
+++ b/arch/arm64/boot/dts/qcom/qcs615-ride.dts
@@ -504,6 +504,7 @@ &usb {
 &usb_dwc3 {
 	dr_mode = "peripheral";
 };
+
 &sdhc_1 {
 	status = "okay";
 
@@ -515,3 +516,13 @@ &sdhc_1 {
 &watchdog {
 	clocks = <&sleep_clk>;
 };
+
+&sdhc_2 {
+	status = "okay";
+
+	vmmc-supply = <&vreg_l10a>;
+	vqmmc-supply = <&vreg_s4a>;
+
+	gpios = <&tlmm 99 GPIO_ACTIVE_LOW>;
+
+};
\ No newline at end of file
diff --git a/arch/arm64/boot/dts/qcom/qcs615.dtsi b/arch/arm64/boot/dts/qcom/qcs615.dtsi
index 125e22536fa8..c32639e820d8 100644
--- a/arch/arm64/boot/dts/qcom/qcs615.dtsi
+++ b/arch/arm64/boot/dts/qcom/qcs615.dtsi
@@ -31,6 +31,7 @@ aliases {
 		i2c6 = &i2c6;
 		i2c7 = &i2c7;
 		mmc0 = &sdhc_1;
+		mmc1 = &sdhc_2;
 		spi2 = &spi2;
 		spi4 = &spi4;
 		spi6 = &spi6;
@@ -1138,6 +1139,54 @@ sdc1_rclk_sleep: sdc1-rclk-sleep-state {
 				bias-pull-down;
 			};
 
+			sdc2_clk: sdc2_clk-state {
+				pins = "sdc2_clk";
+				bias-disable;		/* NO pull */
+				drive-strength = <16>;	/* 16 MA */
+			};
+
+			sdc2_cmd: sdc2_cmd-state {
+				pins = "sdc2_cmd";
+				bias-pull-up;		/* pull up */
+				drive-strength = <10>;	/* 10 MA */
+			};
+
+			sdc2_data: sdc2_data-state {
+				pins = "sdc2_data";
+				bias-pull-up;		/* pull up */
+				drive-strength = <10>;	/* 10 MA */
+			};
+
+			sdc2_sd_cd: sdc2_sd_cd-state {
+				pins = "gpio99";
+				bias-pull-up;           /* pull up */
+				drive-strength = <2>;   /* 2 MA */
+			};
+
+			sdc2_off_clk: sdc2_off_clk-state {
+				pins = "sdc2_clk";
+				bias-disable;		/* NO pull */
+				drive-strength = <2>;	/* 2 MA */
+			};
+
+			sdc2_off_cmd: sdc2_off_cmd-state {
+				pins = "sdc2_cmd";
+				bias-pull-up;		/* pull up */
+				drive-strength = <2>;	/* 2 MA */
+			};
+
+			sdc2_off_data: sdc2_off_data-state {
+				pins = "sdc2_data";
+				bias-pull-up;		/* pull up */
+				drive-strength = <2>;	/* 2 MA */
+			};
+
+			sdc2_off_sd_cd: sdc2_off_sd_cd-state {
+				pins = "gpio99";
+				bias-disable;           /* pull up */
+				drive-strength = <2>;   /* 2 MA */
+			};
+
 			qup_i2c1_data_clk: qup-i2c1-data-clk-state {
 				pins = "gpio4", "gpio5";
 				function = "qup0";
@@ -2311,8 +2360,65 @@ glink_edge: glink-edge {
 				mboxes = <&apss_shared 24>;
 			};
 		};
+
+
+		sdhc_2: sdhci@8804000 {
+			compatible = "qcom,sdhci-msm-v5";
+
+			pinctrl-names = "default", "sleep";
+			pinctrl-0 = <&sdc2_clk>, <&sdc2_cmd>, <&sdc2_data>, <&sdc2_sd_cd>;
+			pinctrl-1 = <&sdc2_off_clk>, <&sdc2_off_cmd>, <&sdc2_off_data>, <&sdc2_off_sd_cd>;
+
+			reg = <0x0 0x8804000 0x0 0x1000>;
+			reg-names = "hc";
+
+			interrupts = <GIC_SPI 204 IRQ_TYPE_LEVEL_HIGH>,
+					<GIC_SPI 222 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "hc_irq", "pwr_irq";
+
+			clocks = <&gcc GCC_SDCC2_AHB_CLK>,
+				<&gcc GCC_SDCC2_APPS_CLK>;
+			clock-names = "iface", "core";
+
+			power-domains = <&rpmhpd RPMHPD_CX>;
+			operating-points-v2 = <&sdhc2_opp_table>;
+			iommus = <&apps_smmu 0x02A0 0x0>;
+			resets = <&gcc GCC_SDCC2_BCR>;
+
+			interconnects = <&aggre1_noc MASTER_SDCC_2 0 &mc_virt SLAVE_EBI1 0>,
+				<&gem_noc MASTER_APPSS_PROC 0 &config_noc SLAVE_SDCC_2 0>;
+			interconnect-names = "sdhc-ddr","cpu-sdhc";
+
+			bus-width = <4>;
+
+			dma-coherent;
+
+			status = "disabled";
+			qcom,dll-config = <0x0007642c>;
+			qcom,ddr-config = <0x80040868>;
+
+			sdhc2_opp_table: opp-table {
+				compatible = "operating-points-v2";
+
+				opp-100000000 {
+					opp-hz = /bits/ 64 <100000000>;
+					required-opps = <&rpmhpd_opp_svs>;
+					opp-peak-kBps = <250000 133320>;
+					opp-avg-kBps = <261438 150000>;
+				};
+
+				opp-202000000 {
+					opp-hz = /bits/ 64 <202000000>;
+					required-opps = <&rpmhpd_opp_nom>;
+					opp-peak-kBps = <800000 300000>;
+					opp-avg-kBps = <261438 300000>;
+				};
+			};
+		};
+
 	};
 
+
 	arch_timer: timer {
 		compatible = "arm,armv8-timer";
 		interrupts = <GIC_PPI 1 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
-- 
2.34.1

