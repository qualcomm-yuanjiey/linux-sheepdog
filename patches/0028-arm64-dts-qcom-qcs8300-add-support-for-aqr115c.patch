From 3ae4c49aad95418d732d96813bb76726fe8acdde Mon Sep 17 00:00:00 2001
From: Yijie Yang <quic_yijiyang@quicinc.com>
Date: Mon, 29 Jul 2024 09:40:26 +0800
Subject: [PATCH 28/30] arm64: dts: qcom: qcs8300: add support for aqr115c

---
 arch/arm64/boot/dts/qcom/qcs8300-ride.dts | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/qcs8300-ride.dts b/arch/arm64/boot/dts/qcom/qcs8300-ride.dts
index 590ee1aa3cac..a7a0a765bde3 100644
--- a/arch/arm64/boot/dts/qcom/qcs8300-ride.dts
+++ b/arch/arm64/boot/dts/qcom/qcs8300-ride.dts
@@ -196,7 +196,7 @@ vreg_l9c: ldo9 {
 };
 
 &ethernet0 {
-	phy-mode = "sgmii";
+	phy-mode = "2500base-x";
 	phy-handle = <&sgmii_phy0>;
 
 	pinctrl-0 = <&ethernet0_default>;
@@ -214,7 +214,7 @@ mdio {
 		#size-cells = <0>;
 
 		sgmii_phy0: phy@8 {
-			compatible = "ethernet-phy-id0141.0dd4";
+			compatible = "ethernet-phy-id31c3.1c33";
 			reg = <0x8>;
 			device_type = "ethernet-phy";
 			interrupts-extended = <&tlmm 4 IRQ_TYPE_EDGE_FALLING>;
-- 
2.34.1

