From 8ec001356d74136f0eb8d8e54a49d50c1dc8867b Mon Sep 17 00:00:00 2001
From: Lijuan Gao <quic_lijuang@quicinc.com>
Date: Tue, 24 Sep 2024 10:10:10 +0800
Subject: [PATCH 62/65] arm64: dts: qcom: qcs615: add ADSP and CDSP nodes

Add nodes for remoteprocs: ADSP and CDSP for QCS615 SoC.

Signed-off-by: Lijuan Gao <quic_lijuang@quicinc.com>
---
 arch/arm64/boot/dts/qcom/qcs615.dtsi | 86 ++++++++++++++++++++++++++++
 1 file changed, 86 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/qcs615.dtsi b/arch/arm64/boot/dts/qcom/qcs615.dtsi
index f4b9cd3f6a7c..a0a675e01599 100644
--- a/arch/arm64/boot/dts/qcom/qcs615.dtsi
+++ b/arch/arm64/boot/dts/qcom/qcs615.dtsi
@@ -1469,6 +1469,47 @@ smp2p_rdbg5_in: qcom,smp2p-rdbg5-in {
 			};
 		};
 
+		remoteproc_cdsp: remoteproc-cdsp@8300000 {
+			compatible = "qcom,qcs615-cdsp-pas";
+			reg = <0x0 0x8300000 0x0 0x100000>;
+
+			interrupts-extended = <&intc GIC_SPI 578 IRQ_TYPE_EDGE_RISING>,
+			                      <&cdsp_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
+			                      <&cdsp_smp2p_in 2 IRQ_TYPE_EDGE_RISING>,
+			                      <&cdsp_smp2p_in 1 IRQ_TYPE_EDGE_RISING>,
+			                      <&cdsp_smp2p_in 3 IRQ_TYPE_EDGE_RISING>;
+			interrupt-names = "wdog",
+			                  "fatal",
+			                  "handover",
+			                  "ready",
+			                  "stop-ack";
+
+			clocks = <&rpmhcc RPMH_CXO_CLK>;
+			clock-names = "xo";
+
+			power-domains = <&rpmhpd RPMHPD_CX>;
+			power-domain-names = "cx";
+
+			interconnects = <&aggre1_noc MASTER_CRYPTO 0 &mc_virt SLAVE_EBI1 0>;
+			interconnect-names = "crypto_ddr";
+
+			memory-region = <&rproc_cdsp_mem>;
+
+			qcom,qmp = <&aoss_qmp>;
+
+			status = "disabled";
+
+			qcom,smem-states = <&cdsp_smp2p_out 0>;
+			qcom,smem-state-names = "stop";
+
+			glink-edge {
+				interrupts = <GIC_SPI 574 IRQ_TYPE_EDGE_RISING>;
+				label = "cdsp";
+				qcom,remote-pid = <5>;
+				mboxes = <&apss_shared 4>;
+			};
+		};
+
 		llcc: system-cache-controller@9200000 {
 			compatible = "qcom,qcs615-llcc";
 			reg = <0x0 0x9200000 0x0 0x50000>, <0x0 0x9600000 0x0 0x50000>;
@@ -1731,6 +1772,13 @@ pdc: interrupt-controller@b220000 {
 			interrupt-controller;
 		};
 
+		qmp_aop: qcom,qmp-aop@c300000 {
+			compatible = "qcom,qmp-mbox";
+			qcom,qmp = <&aoss_qmp>;
+			label = "aop";
+			#mbox-cells = <1>;
+		};
+
 		sram@c3f0000 {
 			compatible = "qcom,rpmh-stats";
 			reg = <0x0 0x0c3f0000 0x0 0x400>;
@@ -2015,6 +2063,44 @@ rpmhpd_opp_turbo_l1: opp-9 {
 				};
 			};
 		};
+
+		remoteproc_adsp: remoteproc-adsp@62400000 {
+			compatible = "qcom,qcs615-adsp-pas";
+			reg = <0x0 0x62400000 0x0 0x00100>;
+
+			interrupts-extended = <&intc GIC_SPI 162 IRQ_TYPE_EDGE_RISING>,
+			                      <&adsp_smp2p_in 0 IRQ_TYPE_EDGE_RISING>,
+			                      <&adsp_smp2p_in 2 IRQ_TYPE_EDGE_RISING>,
+			                      <&adsp_smp2p_in 1 IRQ_TYPE_EDGE_RISING>,
+			                      <&adsp_smp2p_in 3 IRQ_TYPE_EDGE_RISING>;
+			interrupt-names = "wdog", "fatal", "handover",
+					  "ready", "stop-ack";
+
+			clocks = <&rpmhcc RPMH_CXO_CLK>;
+			clock-names = "xo";
+
+			power-domains = <&rpmhpd RPMHPD_CX>;
+			power-domain-names = "cx";
+
+			memory-region = <&rproc_adsp_mem>;
+
+			mboxes = <&qmp_aop 0>;
+
+			interconnects = <&aggre1_noc MASTER_CRYPTO 0 &mc_virt SLAVE_EBI1 0>;
+			interconnect-names = "crypto_ddr";
+
+			qcom,smem-states = <&adsp_smp2p_out 0>;
+			qcom,smem-state-names = "stop";
+
+			status = "disabled";
+
+			glink_edge: glink-edge {
+				interrupts = <GIC_SPI 170 IRQ_TYPE_EDGE_RISING>;
+				label = "adsp";
+				qcom,remote-pid = <2>;
+				mboxes = <&apss_shared 24>;
+			};
+		};
 	};
 
 	dwc3_mem_region: dwc3_mem_region {
-- 
2.34.1

