From 75992b9ff6998df66a3e6e07e4b5cf365051ff7f Mon Sep 17 00:00:00 2001
From: Lijuan Gao <quic_lijuang@quicinc.com>
Date: Fri, 30 Aug 2024 14:52:34 +0800
Subject: [PATCH 07/30] dt-bindings: pinctrl: describe qcs615-tlmm

Add DT bindings for the TLMM controller on QCS615 platforms.

Signed-off-by: Lijuan Gao <quic_lijuang@quicinc.com>
---
 .../bindings/pinctrl/qcom,qcs615-pinctrl.yaml | 128 ++++++++++++++++++
 1 file changed, 128 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/pinctrl/qcom,qcs615-pinctrl.yaml

diff --git a/Documentation/devicetree/bindings/pinctrl/qcom,qcs615-pinctrl.yaml b/Documentation/devicetree/bindings/pinctrl/qcom,qcs615-pinctrl.yaml
new file mode 100644
index 000000000000..5f5efc20f79c
--- /dev/null
+++ b/Documentation/devicetree/bindings/pinctrl/qcom,qcs615-pinctrl.yaml
@@ -0,0 +1,128 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/pinctrl/qcom,qcs615-tlmm.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Qualcomm Technologies, Inc. QCS615 TLMM block
+
+maintainers:
+  - Lijuan Gao <quic_lijuang@quicinc.com>
+
+description:
+  Top Level Mode Multiplexer pin controller in Qualcomm QCS615 SoC.
+
+allOf:
+  - $ref: /schemas/pinctrl/qcom,tlmm-common.yaml#
+
+properties:
+  compatible:
+    const: qcom,qcs615-tlmm
+
+  reg:
+    maxItems: 1
+
+  interrupts:
+    maxItems: 1
+
+  gpio-reserved-ranges:
+    minItems: 1
+    maxItems: 62
+
+  gpio-line-names:
+    maxItems: 123
+
+patternProperties:
+  "-state$":
+    oneOf:
+      - $ref: "#/$defs/qcom-x1e80100-tlmm-state"
+      - patternProperties:
+          "-pins$":
+            $ref: "#/$defs/qcom-x1e80100-tlmm-state"
+        additionalProperties: false
+
+$defs:
+  qcom-qcs615-tlmm-state:
+    type: object
+    description:
+      Pinctrl node's client devices use subnodes for desired pin configuration.
+      Client device subnodes use below standard properties.
+    $ref: qcom,tlmm-common.yaml#/$defs/qcom-tlmm-state
+    unevaluatedProperties: false
+
+    properties:
+      pins:
+        description:
+          List of gpio pins affected by the properties specified in this
+          subnode.
+        items:
+          oneOf:
+            - pattern: "^gpio([0-9]|[1-9][0-9]|1[0-2][0-9]|12[0-2])$"
+            - enum: [ ufs_reset, sdc1_rclk, sdc1_clk, sdc1_cmd,
+                      sdc1_data, sdc2_clk, sdc2_cmd, sdc2_data ]
+        minItems: 1
+        maxItems: 36
+
+      function:
+        description:
+          Specify the alternative function to be configured for the specified
+          pins.
+        enum: [ gpio, agera_pll, copy_phase, cri_trng, gps_tx, gp_pdm0,
+                gp_pdm1, gp_pdm2, jitter_bist, nav_pps, pll_bist, sp_cmu,
+                wsa_clk, wsa_data, adsp_ext, aoss_cti, atest_char,
+                atest_char_status, atest_tsens, atest_tsens2, atest_usb,
+                cam_mclk, cci_async, cci_i2c, cci_timer, copy_gp,
+                dbg_out_clk, ddr_bist, ddr_pxi0, ddr_pxi1, ddr_pxi2,
+                ddr_pxi3, dp_hot, edp_hot, edp_lcd, emac_gcc0, emac_gcc1,
+                emac_phy_intr, forced_usb, gcc_gp1, gcc_gp2, gcc_gp3,
+                hs0_mi2s, hs1_mi2s, ldo_en, ldo_update, m_voc, mclk1, mclk2,
+                mdp_vsync, mdp_vsync0_out, mdp_vsync1_out, mdp_vsync2_out,
+                mdp_vsync3_out, mdp_vsync4_out, mdp_vsync5_out, mi2s_1,
+                mss_lte, pa_indicator_or, pcie_clk_req, pcie_ep_rst,
+                phase_flag, pll_bypassnl, pll_reset_n, prng_rosc, qdss_cti,
+                qdss_gpio, qlink_enable, qlink_request, qspi0, qspi1, qspi2,
+                qspi3, qspi_clk, qspi_cs, qup0_se0, qup0_se1, qup0_se2,
+                qup0_se3, qup1_se0, qup1_se1, qup1_se2, qup1_se3, rgmii,
+                sd_write_protect, ter_mi2s, tgu_ch0_trigout, tgu_ch1_trigout,
+                tgu_ch2_trigout, tgu_ch3_trigout, uim1, uim2, usb0_hs,
+                usb1_hs, usb_phy_ps, vfr_1, vsense_trigger_mirnat, wlan1_adc0,
+                wlan1_adc1, wlan2_adc0, wlan2_adc1 ]
+
+    required:
+      - pins
+
+required:
+  - compatible
+  - reg
+
+unevaluatedProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/interrupt-controller/arm-gic.h>
+	tlmm: pinctrl@3000000 {
+		compatible = "qcom,qcs615-pinctrl";
+		reg = <0x03000000 0xdc2000>,
+                      <0x017c000f0 0x50>;
+		gpio-controller;
+		#gpio-cells = <2>;
+		gpio-ranges = <&tlmm 0 0 124>;
+		gpio-reserved-ranges = <0 4>, <126 4>;
+		interrupt-controller;
+		#interrupt-cells = <2>;
+		interrupts = <GIC_SPI 208 IRQ_TYPE_LEVEL_HIGH>;
+                             <GIC_SPI 209 IRQ_TYPE_LEVEL_HIGH>,
+                             <GIC_SPI 210 IRQ_TYPE_LEVEL_HIGH>,
+                             <GIC_SPI 211 IRQ_TYPE_LEVEL_HIGH>,
+                             <GIC_SPI 212 IRQ_TYPE_LEVEL_HIGH>,
+                             <GIC_SPI 213 IRQ_TYPE_LEVEL_HIGH>,
+                             <GIC_SPI 214 IRQ_TYPE_LEVEL_HIGH>,
+                             <GIC_SPI 215 IRQ_TYPE_LEVEL_HIGH>,
+                             <GIC_SPI 216 IRQ_TYPE_LEVEL_HIGH>;
+
+                qup3-uart2-state {
+                    pins ="gpio16", "gpio17";
+                    function = "qup0_se0";
+                };
+       };
+...
-- 
2.34.1

