From 6b2ffd8ff15c2f66a40ebe0ff2cf68f0bb61c11f Mon Sep 17 00:00:00 2001
From: Qingqing Zhou <quic_qqzhou@quicinc.com>
Date: Fri, 13 Sep 2024 14:50:17 +0530
Subject: [PATCH 18/68] arm64: dts: qcom: qcs615: add the GPU SMMU node

Add the Adreno GPU IOMMU for qcs615-based platforms.

Signed-off-by: Qingqing Zhou <quic_qqzhou@quicinc.com>
---
 arch/arm64/boot/dts/qcom/qcs615.dtsi | 28 ++++++++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/qcs615.dtsi b/arch/arm64/boot/dts/qcom/qcs615.dtsi
index 65fe3e2c3340..b6fdf37364c5 100644
--- a/arch/arm64/boot/dts/qcom/qcs615.dtsi
+++ b/arch/arm64/boot/dts/qcom/qcs615.dtsi
@@ -495,6 +495,34 @@ qup_uart0_rx: qup-uart0-rx-state {
 			};
 		};
 
+		adreno_smmu: iommu@50a0000 {
+			compatible = "qcom,qcs615-smmu-500",
+			             "qcom,adreno-smmu",
+			             "qcom,smmu-500",
+			             "arm,mmu-500";
+			reg = <0x0 0x50a0000 0x0 0x10000>;
+			#iommu-cells = <2>;
+			#global-interrupts = <1>;
+
+			power-domains = <&gpucc CX_GDSC>;
+			clocks = <&gcc GCC_GPU_MEMNOC_GFX_CLK>,
+			         <&gcc GCC_GPU_SNOC_DVM_GFX_CLK>,
+			         <&gpucc GPU_CC_HLOS1_VOTE_GPU_SMMU_CLK>;
+			clock-names = "gcc_gpu_memnoc_gfx_clk",
+			              "gcc_gpu_snoc_dvm_gfx_clk",
+			              "gpu_cc_hlos1_vote_gpu_smmu_clk";
+
+			interrupts = <GIC_SPI 585 IRQ_TYPE_LEVEL_HIGH>,
+			             <GIC_SPI 590 IRQ_TYPE_LEVEL_HIGH>,
+			             <GIC_SPI 591 IRQ_TYPE_LEVEL_HIGH>,
+			             <GIC_SPI 592 IRQ_TYPE_LEVEL_HIGH>,
+			             <GIC_SPI 593 IRQ_TYPE_LEVEL_HIGH>,
+			             <GIC_SPI 594 IRQ_TYPE_LEVEL_HIGH>,
+			             <GIC_SPI 595 IRQ_TYPE_LEVEL_HIGH>,
+			             <GIC_SPI 596 IRQ_TYPE_LEVEL_HIGH>,
+			             <GIC_SPI 597 IRQ_TYPE_LEVEL_HIGH>;
+		};
+
 		dc_noc: interconnect@9160000 {
 			reg = <0x0 0x9160000 0x0 0x3200>;
 			compatible = "qcom,qcs615-dc-noc";
-- 
2.34.1

