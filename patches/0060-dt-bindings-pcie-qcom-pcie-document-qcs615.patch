     then:
       properties:
         clocks:
@@ -561,6 +564,7 @@ allOf:
                 - qcom,pcie-ipq8074-gen3
                 - qcom,pcie-ipq9574
                 - qcom,pcie-qcs404
+                - qcom,pcie-qcs615
     then:
       required:
         - power-domains
@@ -620,6 +624,7 @@ allOf:
               - qcom,pcie-ipq8074
               - qcom,pcie-ipq8074-gen3
               - qcom,pcie-qcs404
+              - qcom,pcie-qcs615
     then:
       properties:
         interrupts:
